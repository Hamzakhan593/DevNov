# Configure credentials when contact forms are implemented in a later module.
# Never put private API keys in VITE_* variables; they are bundled for browsers.
VITE_WEB3FORMS_ACCESS_KEY=
VITE_CALENDLY_URL=

# Public browser configuration for the DevNov content backend.
# Create these in your Supabase project Settings > API. Never put a service-role
# key, database password, or other private credential in a VITE_ variable.
VITE_SUPABASE_URL=
# Preferred key for browser code (starts with sb_publishable_).
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only. Existing anon keys also work but new projects should
# use VITE_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_ANON_KEY=
